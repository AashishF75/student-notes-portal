# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# e.g.: mongodb+srv://<username>:<password>@cluster0.gnxspvv.mongodb.net/studentNotes?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studentNotes?retryWrites=true&w=majority

# Frontend Client URL (For CORS allowlist in production)
CLIENT_URL=http://localhost:5173

# Note: Binary PDF storage is managed directly in MongoDB Atlas using GridFS (pdfs.files and pdfs.chunks).
# No external Cloudinary or third-party storage configuration is required!
